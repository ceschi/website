# Static site, no build step: everything the page loads (vendor/, fonts/,
# papers/, charts/, build-info.js) must be committed. Do not ignore vendor/:
# index.html loads React from it and Pages would deploy a blank page.

# Dependencies (not used now; guards against an accidental npm install)
node_modules/

# Local environment and secrets
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
secrets/

# Editor and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.vscode
*.code-workspace

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.tmp/
tmp/
